{
  "name": "vue3-rag",
  "version": "1.0.0",
  "description": "Vue 3 Documentation RAG with Hybrid Fuzzy & Semantic Search",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/ejs-templates/views', 'dist/ejs-templates/views', { recursive: true })\"",
    "start": "node dist/standalone.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "ejs": "^3.1.10",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^16.18.0",
    "@types/sql.js": "^1.4.9",
    "prisma": "^5.22.0",
    "typescript": "^5.3.3"
  }
}
