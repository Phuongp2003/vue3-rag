<div style="display: flex; gap: 20px; height: calc(100vh - 48px); padding: 12px 16px;">

  <!-- Left: Sidebar Navigator & Search Controls -->
  <div style="width: 380px; min-width: 330px; display: flex; flex-direction: column; border-right: 1px solid #1e293b; padding-right: 16px;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
      <h2 style="font-size: 13px; font-weight: 700; color: #42b883; text-transform: uppercase; letter-spacing: 0.08em;">Vue 3 API & Components</h2>
      <div style="display: flex; gap: 4px; align-items: center;">
        <button class="btn btn-outline" style="padding: 1px 5px; font-size: 10px;" title="Re-index all vectors using active provider or dense feature embeddings" onclick="triggerReindex(this)">⚡ Re-embed</button>
        <span id="docCountBadge" style="font-size: 11px; background: #1e293b; padding: 2px 7px; border-radius: 4px; color: #94a3b8; font-family: monospace;">Loading...</span>
      </div>
    </div>

    <!-- Search Input -->
    <div style="margin-bottom: 8px;">
      <input
        type="text"
        id="wikiSearchInput"
        class="input-text"
        placeholder="Search keywords or intent ('prop drilling', 'teleport')..."
        style="padding: 6px 10px; font-size: 12px;"
        oninput="handleSearch(this.value)"
      />
    </div>

    <!-- Search Strategy Mode Box -->
    <div class="card" style="padding: 8px 10px; margin-bottom: 8px; background: #050811;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
        <span style="font-size: 11px; color: #64748b; font-weight: 600;">SEARCH MODE:</span>
        <div style="display: flex; gap: 4px;">
          <button class="btn btn-outline mode-btn" onclick="setMode('fuzzy', this)" style="padding: 2px 6px; font-size: 10.5px;">Fuzzy</button>
          <button class="btn btn-outline mode-btn" onclick="setMode('semantic', this)" style="padding: 2px 6px; font-size: 10.5px;">Semantic</button>
          <button class="btn btn-outline mode-btn active" onclick="setMode('hybrid', this)" style="padding: 2px 6px; font-size: 10.5px; background: #1e293b; color: #42b883; border-color: #42b883;">Hybrid</button>
        </div>
      </div>

      <!-- Hybrid Slider -->
      <div id="hybridSliderWrap" style="display: flex; align-items: center; gap: 8px; font-size: 11px; color: #64748b;">
        <span>Fuzzy</span>
        <input type="range" id="hybridWeightSlider" min="0" max="1" step="0.1" value="0.5" style="flex: 1; accent-color: #42b883;" oninput="handleWeightChange(this.value)">
        <span>Semantic</span>
        <span id="sliderValueText" style="font-family: monospace; color: #42b883;">50%</span>
      </div>
    </div>

    <!-- Category Filters -->
    <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px;">
      <button class="btn btn-outline cat-btn active" onclick="setCategory('ALL', this)" style="padding: 2px 6px; font-size: 11px; background: #1e293b; color: #42b883; border-color: #42b883;">All</button>
      <button class="btn btn-outline cat-btn" onclick="setCategory('reactivity', this)" style="padding: 2px 6px; font-size: 11px;">Reactivity</button>
      <button class="btn btn-outline cat-btn" onclick="setCategory('composition-api', this)" style="padding: 2px 6px; font-size: 11px;">Composition</button>
      <button class="btn btn-outline cat-btn" onclick="setCategory('components', this)" style="padding: 2px 6px; font-size: 11px;">Components</button>
      <button class="btn btn-outline cat-btn" onclick="setCategory('options-api', this)" style="padding: 2px 6px; font-size: 11px;">Options API</button>
    </div>

    <!-- Paging Controls Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 2px; margin-bottom: 6px; font-size: 11px; color: #64748b; border-bottom: 1px solid #1e293b;">
      <button class="btn btn-outline" id="btnPrevPage" onclick="changePage(-1)" style="padding: 2px 6px; font-size: 11px;" disabled>&larr; Prev</button>
      <span id="pageInfo" style="font-family: monospace;">Page 1 / 1</span>
      <button class="btn btn-outline" id="btnNextPage" onclick="changePage(1)" style="padding: 2px 6px; font-size: 11px;" disabled>Next &rarr;</button>
    </div>

    <!-- Document List Items -->
    <div id="docList" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 4px;">
      <div style="font-size: 12px; color: #64748b; padding: 12px;">Loading directory...</div>
    </div>
  </div>

  <!-- Right: Technical Specification & Top-K Debug Panel -->
  <div id="docView" style="flex: 1; overflow-y: auto; padding-left: 4px;">

    <!-- TOP-K SEARCH DEBUG CONSOLE (Visual Feedback) -->
    <div id="debugConsole" class="card" style="margin-bottom: 18px; background: #050811; border: 1px solid #1e293b; padding: 12px 16px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <div style="font-size: 11px; font-weight: 700; color: #38bdf8; letter-spacing: 0.08em; text-transform: uppercase;">
          Top-K Candidates Debug Panel &mdash; <span id="debugModeTitle" style="color: #42b883;">HYBRID</span>
        </div>
        <span style="font-size: 10.5px; font-family: monospace; color: #64748b;">Showing Top 5 scored per algorithm</span>
      </div>
      <div id="debugColumns" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; font-size: 11.5px;">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Document Content Render Area -->
    <div id="docContent">
      <div style="color: #64748b; font-size: 13px;">Select an item from the left to inspect.</div>
    </div>
  </div>

</div>

<script>
  let currentSearchQuery = '';
  let currentCategory = 'ALL';
  let currentSearchMode = 'hybrid';
  let currentHybridWeight = 0.5;
  let currentPage = 1;
  let totalPages = 1;
  let debounceTimer = null;

  async function fetchDocuments(page = 1) {
    currentPage = page;
    const listEl = document.getElementById('docList');
    listEl.innerHTML = '<div style="font-size: 12px; color: #64748b; padding: 12px;">Searching...</div>';

    const params = new URLSearchParams({
      page: currentPage.toString(),
      limit: '30',
      category: currentCategory,
      q: currentSearchQuery,
      mode: currentSearchMode,
      weight: currentHybridWeight.toString()
    });

    try {
      const res = await fetch('/api/documents?' + params.toString());
      const data = await res.json();

      totalPages = data.pagination.totalPages || 1;
      document.getElementById('docCountBadge').innerText = data.total + ' ENTRIES';
      document.getElementById('pageInfo').innerText = 'Page ' + data.pagination.page + ' / ' + totalPages;

      document.getElementById('btnPrevPage').disabled = currentPage <= 1;
      document.getElementById('btnNextPage').disabled = currentPage >= totalPages;

      renderDebugPanel(data.debug);
      renderItems(data.results || []);
    } catch (e) {
      listEl.innerHTML = '<div style="color: #f87171; padding: 12px;">Failed to load documents: ' + e.message + '</div>';
    }
  }

  function renderDebugPanel(debug) {
    if (!debug) return;
    document.getElementById('debugModeTitle').innerText = debug.mode.toUpperCase() + (debug.mode === 'hybrid' ? ` (${Math.round(debug.weight * 100)}% Semantic)` : '');
    const colContainer = document.getElementById('debugColumns');

    let html = '';

    // 1. Top Fuzzy
    html += '<div style="background: #090d16; border: 1px solid #1e293b; border-radius: 4px; padding: 8px 10px;">';
    html += '<div style="font-weight: 700; color: #fbbf24; margin-bottom: 4px; font-size: 11px;">Top-K Fuzzy Matches</div>';
    (debug.topKFuzzy || []).forEach(f => {
      html += '<div style="display: flex; justify-content: space-between; margin-bottom: 2px;">';
      html += '<span style="color: #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px;">' + escapeHtml(f.title) + '</span>';
      html += '<span style="color: #fbbf24; font-family: monospace;">' + f.fuzzyScore + '</span>';
      html += '</div>';
    });
    html += '</div>';

    // 2. Top Semantic
    html += '<div style="background: #090d16; border: 1px solid #1e293b; border-radius: 4px; padding: 8px 10px;">';
    html += '<div style="font-weight: 700; color: #38bdf8; margin-bottom: 4px; font-size: 11px;">Top-K Semantic Matches</div>';
    (debug.topKSemantic || []).forEach(s => {
      html += '<div style="display: flex; justify-content: space-between; margin-bottom: 2px;">';
      html += '<span style="color: #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px;">' + escapeHtml(s.title) + '</span>';
      html += '<span style="color: #38bdf8; font-family: monospace;">' + s.semanticScore + '</span>';
      html += '</div>';
    });
    html += '</div>';

    // 3. Top Hybrid (Combined)
    html += '<div style="background: #090d16; border: 1px solid #1e293b; border-radius: 4px; padding: 8px 10px;">';
    html += '<div style="font-weight: 700; color: #42b883; margin-bottom: 4px; font-size: 11px;">Top-K Hybrid Rank</div>';
    (debug.topKHybrid || []).forEach(h => {
      html += '<div style="display: flex; justify-content: space-between; margin-bottom: 2px;">';
      html += '<span style="color: #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px;">' + escapeHtml(h.title) + '</span>';
      html += '<span style="color: #42b883; font-family: monospace; font-weight: 600;">' + h.hybridScore + '</span>';
      html += '</div>';
    });
    html += '</div>';

    colContainer.innerHTML = html;
  }

  function handleSearch(val) {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      currentSearchQuery = val.trim();
      fetchDocuments(1);
    }, 250);
  }

  function setMode(mode, btn) {
    document.querySelectorAll('.mode-btn').forEach(b => {
      b.style.borderColor = '#334155';
      b.style.color = '#cbd5e1';
      b.style.background = 'transparent';
    });
    btn.style.borderColor = '#42b883';
    btn.style.color = '#42b883';
    btn.style.background = '#1e293b';

    currentSearchMode = mode;
    document.getElementById('hybridSliderWrap').style.display = mode === 'hybrid' ? 'flex' : 'none';
    fetchDocuments(1);
  }

  function handleWeightChange(val) {
    currentHybridWeight = parseFloat(val);
    document.getElementById('sliderValueText').innerText = Math.round(currentHybridWeight * 100) + '%';
    fetchDocuments(1);
  }

  function setCategory(cat, btn) {
    document.querySelectorAll('.cat-btn').forEach(b => {
      b.style.borderColor = '#334155';
      b.style.color = '#cbd5e1';
      b.style.background = 'transparent';
    });
    btn.style.borderColor = '#42b883';
    btn.style.color = '#42b883';
    btn.style.background = '#1e293b';

    currentCategory = cat;
    fetchDocuments(1);
  }

  function changePage(delta) {
    const target = currentPage + delta;
    if (target >= 1 && target <= totalPages) {
      fetchDocuments(target);
    }
  }

  function renderItems(results) {
    const listEl = document.getElementById('docList');
    if (!results || results.length === 0) {
      listEl.innerHTML = '<div style="font-size: 12px; color: #475569; padding: 12px;">No matching records.</div>';
      return;
    }

    let html = '';
    results.forEach((item) => {
      const doc = item.doc;
      const scoreBadge = item.score !== undefined ? `<span style="font-family: monospace; color: #42b883; font-size: 11px;">★ ${item.score}</span>` : '';

      html += `<div class="wiki-item" id="item-${doc.id}" onclick="selectDoc('${doc.id}')" style="padding: 7px 10px; border-radius: 4px; cursor: pointer; border: 1px solid #1e293b; background: #0f172a; transition: background 0.1s, border-color 0.1s;">`;
      html += `<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">`;
      html += `<span style="font-size: 12.5px; font-weight: 700; color: #f8fafc;">${escapeHtml(doc.title)}</span>`;
      html += scoreBadge;
      html += `</div>`;
      html += `<div style="font-size: 11px; color: #94a3b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 2px;">${escapeHtml(doc.summary)}</div>`;
      html += `<div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: #64748b;">`;
      html += `<span style="color: #38bdf8; text-transform: uppercase;">${escapeHtml(doc.category)}</span>`;
      html += `<span style="font-family: monospace; color: #cbd5e1;">v${escapeHtml(doc.vueVersion)}</span>`;
      html += `</div></div>`;
    });

    listEl.innerHTML = html;

    if (results.length > 0) {
      selectDoc(results[0].doc.id);
    }
  }

  async function selectDoc(docId) {
    document.querySelectorAll('.wiki-item').forEach(el => {
      el.style.background = '#0f172a';
      el.style.borderColor = '#1e293b';
    });
    const activeEl = document.getElementById('item-' + docId);
    if (activeEl) {
      activeEl.style.background = '#1e293b';
      activeEl.style.borderColor = '#42b883';
    }

    const container = document.getElementById('docContent');
    container.innerHTML = '<div style="color: #64748b; font-size: 13px;">Loading documentation...</div>';

    try {
      const res = await fetch('/api/documents/' + docId);
      const doc = await res.json();
      renderDocumentDetail(doc);
    } catch (e) {
      container.innerHTML = '<div style="color: #f87171; font-size: 13px;">Failed to load detail: ' + e.message + '</div>';
    }
  }

  function renderDocumentDetail(doc) {
    const container = document.getElementById('docContent');

    let html = '';

    // Modern Vue 3 Specification Banner
    html += '<div style="background: linear-gradient(90deg, #1e293b 0%, #0f172a 100%); border: 1px solid #334155; border-radius: 8px; padding: 18px 24px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: flex-end;">';
    html += '<div>';
    html += '<div style="font-size: 11px; font-weight: 700; color: #42b883; letter-spacing: 0.15em; margin-bottom: 4px; text-transform: uppercase;">VUE 3 CORE SPECIFICATION &bull; V' + escapeHtml(doc.vueVersion) + '</div>';
    html += '<h1 style="font-size: 26px; font-weight: 800; color: #f8fafc; letter-spacing: -0.02em; margin-bottom: 6px;">' + escapeHtml(doc.title) + '</h1>';
    html += '<div style="display: flex; gap: 8px; font-size: 12px;">';
    html += '<span style="background: #0f172a; border: 1px solid #475569; padding: 2px 8px; border-radius: 4px; color: #38bdf8; font-weight: 600; text-transform: uppercase;">' + escapeHtml(doc.category) + '</span>';
    html += '<span style="background: #0f172a; border: 1px solid #475569; padding: 2px 8px; border-radius: 4px; color: #94a3b8; font-family: monospace;">SLUG: ' + escapeHtml(doc.slug) + '</span>';
    html += '</div></div>';
    if (doc.sourceUrl) {
      html += '<a href="' + escapeHtml(doc.sourceUrl) + '" target="_blank" class="btn btn-outline" style="font-size: 11.5px; color: #42b883; border-color: #42b883;">Official Vue Docs &rarr;</a>';
    }
    html += '</div>';

    // Executive Summary Card
    html += '<div class="card" style="margin-bottom: 16px; border-left: 4px solid #38bdf8;">';
    html += '<div style="font-size: 11px; font-weight: 700; color: #64748b; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px;">Core Purpose</div>';
    html += '<p style="font-size: 13.5px; line-height: 1.6; color: #f1f5f9;">' + escapeHtml(doc.summary) + '</p>';
    html += '</div>';

    // Solved Use Cases (Semantic Intent Matches)
    if (doc.useCases && doc.useCases.length > 0) {
      html += '<div class="card" style="margin-bottom: 16px; border-left: 4px solid #f59e0b;">';
      html += '<div style="font-size: 11px; font-weight: 700; color: #f59e0b; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">Practical Intent & Solved Problems</div>';
      html += '<div style="display: flex; flex-wrap: wrap; gap: 6px;">';
      doc.useCases.forEach(uc => {
        html += '<span style="background: #090d16; border: 1px solid #1e293b; padding: 3px 9px; border-radius: 4px; font-size: 12px; color: #f8fafc;">✔ ' + escapeHtml(uc) + '</span>';
      });
      html += '</div></div>';
    }

    // Dual Code Comparison: Composition API vs Options API
    if (doc.compositionCode || doc.optionsCode) {
      html += '<div style="margin-bottom: 18px;">';
      html += '<div style="font-size: 12px; font-weight: 700; color: #94a3b8; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px;">Implementation Syntaxes</div>';
      html += '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 12px;">';

      if (doc.compositionCode) {
        html += '<div class="card" style="background: #090d16; border-left: 4px solid #10b981; padding: 14px;">';
        html += '<div style="font-size: 12px; font-weight: 700; color: #42b883; margin-bottom: 8px; display: flex; justify-content: space-between;">';
        html += '<span>Composition API (&lt;script setup&gt;)</span>';
        html += '<span style="font-size: 10px; background: #1e293b; padding: 1px 6px; border-radius: 3px; color: #42b883;">Recommended</span>';
        html += '</div>';
        html += '<pre style="margin: 0; background: #050811; padding: 10px; border-radius: 4px;"><code>' + escapeHtml(doc.compositionCode) + '</code></pre>';
        html += '</div>';
      }

      if (doc.optionsCode) {
        html += '<div class="card" style="background: #090d16; border-left: 4px solid #8b5cf6; padding: 14px;">';
        html += '<div style="font-size: 12px; font-weight: 700; color: #a78bfa; margin-bottom: 8px;">Options API</div>';
        html += '<pre style="margin: 0; background: #050811; padding: 10px; border-radius: 4px;"><code>' + escapeHtml(doc.optionsCode) + '</code></pre>';
        html += '</div>';
      }

      html += '</div></div>';
    }

    // Technical Deep-Dive
    if (doc.rawMarkdown) {
      html += '<div class="card" style="padding: 16px 20px;">';
      html += '<div style="font-size: 12px; font-weight: 700; color: #38bdf8; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px;">Technical Deep-Dive & Gotchas</div>';
      html += '<div style="font-size: 13.5px; line-height: 1.7; color: #e2e8f0; white-space: pre-wrap;">' + escapeHtml(doc.rawMarkdown) + '</div>';
      html += '</div>';
    }

    container.innerHTML = html;
  }

  async function triggerReindex(btn) {
    const oldText = btn.innerText;
    btn.disabled = true;
    btn.innerText = 'Indexing...';
    try {
      const res = await fetch('/api/documents/reindex', { method: 'POST' });
      const data = await res.json();
      alert('Reindexed ' + data.count + ' documents with new embeddings!');
      fetchDocuments(currentPage);
    } catch (e) {
      alert('Reindex error: ' + e.message);
    } finally {
      btn.disabled = false;
      btn.innerText = oldText;
    }
  }

  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.innerText = text;
    return div.innerHTML;
  }

  fetchDocuments(1);
</script>
